{
  "name": "gestor-simples-api",
  "version": "1.0.0",
  "description": "gestor simples api rest",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm env:load tsx watch src/server.ts",
    "db:migrate": "pnpm env:load prisma migrate dev",
    "db:generate": "pnpm env:load prisma generate",
    "db:seed": "pnpm env:load prisma db seed",
    "db:reset": "pnpm env:load prisma migrate reset",
    "db:studio": "pnpm env:load prisma studio",
    "env:load": "dotenv -e .env --",
    "build": "tsup",
    "start": "prisma migrate deploy && node dist/main.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/jwt": "10.1.0",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.6",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.10.1",
    "axios": "^1.20.0",
    "bcryptjs": "3.0.3",
    "dotenv-cli": "^11.0.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@faker-js/faker": "10.4.0",
    "@types/node": "25.9.2",
    "@vitest/coverage-v8": "^4.1.12",
    "prisma": "7.8.0",
    "supertest": "^7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
